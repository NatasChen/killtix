# ============================================================================
#  TicketDesk — Cloudflare Workers Configuration (Track B: Edge Deployment)
#  File: wrangler.toml
#  Notes:
#    * This file MUST contain ONLY non-secret values.
#      Secrets (JWT_SECRET, SMTP_PASSWORD, TELEGRAM_BOT_TOKEN,
#      TEAMS_WEBHOOK_URL, SCIM_BEARER_TOKEN, LDAP_BIND_PASSWORD,
#      OIDC_CLIENT_SECRET, SAML_SP_PRIVATE_KEY) are set via `wrangler secret put`.
#    * Replace placeholder IDs (<...>) with real values from `wrangler d1 create`,
#      `wrangler kv namespace create`, and `wrangler queues create`.
# ============================================================================

name = "ticketdesk-api"
main = "src/worker.ts"
compatibility_date = "2026-02-18"
compatibility_flags = ["nodejs_compat"]

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------
[observability]
enabled = true
head_sampling_rate = 1.0

# ---------------------------------------------------------------------------
# Non-secret environment variables (default / production)
# ---------------------------------------------------------------------------
[vars]
APP_ENV = "production"
APP_URL = "https://ticket.example.com"
LOG_LEVEL = "info"
TZ = "Asia/Taipei"
JWT_ACCESS_TTL = "3600"
JWT_REFRESH_TTL = "604800"
SESSION_COOKIE_SECURE = "true"
BCRYPT_COST = "12"
SECURITY_2FA_ENABLED = "true"
SECURITY_2FA_ENFORCE_ROLES = "super_admin,it_manager"
SECURITY_2FA_WEBAUTHN_RP_ID = "ticket.example.com"
PASSWORD_MIN_LENGTH = "12"
LOGIN_MAX_FAILED_ATTEMPTS = "5"
NOTIFY_MAX_ATTEMPTS = "3"
NOTIFY_DEDUP_TTL_SECONDS = "86400"
RATE_LIMIT_DEFAULT_PER_MIN = "60"

# ---------------------------------------------------------------------------
# D1 Database binding (primary data store)
# ---------------------------------------------------------------------------
[[d1_databases]]
binding = "DB"
database_name = "ticketdesk-db"
database_id = "<PRODUCTION_D1_DATABASE_ID>"
migrations_dir = "src/migrations"

# ---------------------------------------------------------------------------
# KV Namespace binding (sessions, token version, rate-limit counters, dedup)
# ---------------------------------------------------------------------------
[[kv_namespaces]]
binding = "KV"
id = "<PRODUCTION_KV_NAMESPACE_ID>"

# ---------------------------------------------------------------------------
# Queues — async notification dispatch
# ---------------------------------------------------------------------------
[[queues.producers]]
binding = "NOTIFY_QUEUE"
queue = "ticketdesk-notifications"

[[queues.consumers]]
queue = "ticketdesk-notifications"
max_batch_size = 10
max_batch_timeout = 5
max_retries = 3
max_concurrency = 6
dead_letter_queue = "ticketdesk-notifications-dlq"

# ---------------------------------------------------------------------------
# Cron Triggers (UTC)
#   */5 * * * *  -> SLA scan (at_risk / overdue detection + notify)
#   0 1 * * *    -> Daily "aging > 3 days" backlog digest to it_manager + Teams
# ---------------------------------------------------------------------------
[triggers]
crons = ["*/5 * * * *", "0 1 * * *"]

# ===========================================================================
# STAGING ENVIRONMENT
# ===========================================================================
[env.staging]
name = "ticketdesk-api-staging"

[env.staging.vars]
APP_ENV = "staging"
APP_URL = "https://staging.ticket.example.com"
LOG_LEVEL = "debug"
TZ = "Asia/Taipei"
JWT_ACCESS_TTL = "3600"
JWT_REFRESH_TTL = "604800"
SESSION_COOKIE_SECURE = "true"
BCRYPT_COST = "12"
SECURITY_2FA_ENABLED = "true"
SECURITY_2FA_ENFORCE_ROLES = "super_admin,it_manager"
SECURITY_2FA_WEBAUTHN_RP_ID = "staging.ticket.example.com"
PASSWORD_MIN_LENGTH = "12"
LOGIN_MAX_FAILED_ATTEMPTS = "5"
NOTIFY_MAX_ATTEMPTS = "3"
NOTIFY_DEDUP_TTL_SECONDS = "86400"
RATE_LIMIT_DEFAULT_PER_MIN = "60"

[[env.staging.d1_databases]]
binding = "DB"
database_name = "ticketdesk-db-staging"
database_id = "<STAGING_D1_DATABASE_ID>"
migrations_dir = "src/migrations"

[[env.staging.kv_namespaces]]
binding = "KV"
id = "<STAGING_KV_NAMESPACE_ID>"

[[env.staging.queues.producers]]
binding = "NOTIFY_QUEUE"
queue = "ticketdesk-notifications-staging"

[[env.staging.queues.consumers]]
queue = "ticketdesk-notifications-staging"
max_batch_size = 10
max_batch_timeout = 5
max_retries = 3
max_concurrency = 6
dead_letter_queue = "ticketdesk-notifications-staging-dlq"

[env.staging.triggers]
crons = ["*/5 * * * *", "0 1 * * *"]

# ===========================================================================
# SECRETS — set via CLI, NEVER place here:
#   npx wrangler secret put JWT_SECRET
#   npx wrangler secret put CSRF_SECRET
#   npx wrangler secret put SMTP_PASSWORD
#   npx wrangler secret put TELEGRAM_BOT_TOKEN
#   npx wrangler secret put TEAMS_WEBHOOK_URL
#   npx wrangler secret put SCIM_BEARER_TOKEN
#   npx wrangler secret put LDAP_BIND_PASSWORD        # if LDAP/AD enabled
#   npx wrangler secret put OIDC_CLIENT_SECRET        # if OIDC enabled
#   npx wrangler secret put SAML_SP_PRIVATE_KEY       # if SAML enabled
# ===========================================================================
