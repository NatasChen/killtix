# ============================================================================
# TicketDesk environment — copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 48
# ============================================================================

# Public URL users open (used in notification links). Use https:// in production;
# that also turns on Secure cookies and HSTS.
APP_URL=http://localhost:8080
# Interface/port the app is published on. 127.0.0.1 = local only (put a TLS reverse proxy in front).
APP_BIND=127.0.0.1
APP_PORT=8080

# REQUIRED secrets
APP_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Set to true when running behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
TZ=Asia/Taipei
DEFAULT_LOCALE=zh-TW

# Bootstrap administrator (created only on first start with an empty database).
# Leave the password empty to have a random one generated and printed once in the app log.
BOOTSTRAP_ADMIN_EMAIL=admin@ticket.local
BOOTSTRAP_ADMIN_PASSWORD=

# Notifications (leave empty to disable a channel)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=TicketDesk <no-reply@example.com>
TELEGRAM_BOT_TOKEN=
TEAMS_WEBHOOK_URL=

# Hour (app timezone) after which the daily "unresolved > 3 days" digest is posted to Teams.
AGING_DIGEST_HOUR=9
