# ============================================================================
# TicketDesk environment — copy to .env and fill in. Never commit .env.
# Generate secrets with:  openssl rand -base64 48
# ============================================================================

# Public URL users open (used in notification links). Use https:// in production;
# that also turns on Secure cookies and HSTS. Include the port if HTTP_PORT is not 80.
APP_URL=http://localhost
# Interface/port the bundled nginx listens on (HTTP). The app itself is not published on the host.
HTTP_BIND=0.0.0.0
HTTP_PORT=80

# REQUIRED secrets
APP_SECRET=
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# The bundled nginx sets X-Forwarded-For to the client address; keep true with docker compose.
TRUST_PROXY=true
TZ=Asia/Taipei
DEFAULT_LOCALE=zh-TW

# Bootstrap administrator (created only on first start with an empty database).
# Leave the password empty to have a random one generated and printed once in the app log.
BOOTSTRAP_ADMIN_EMAIL=admin@ticket.local
BOOTSTRAP_ADMIN_PASSWORD=

# Notifications (e-mail, Telegram, Teams) are set up in the web UI: Settings → Notifications / E-mail settings.
# They are off until an administrator turns them on there.

# Hour (app timezone) after which the daily "unresolved > 3 days" digest is posted to Teams.
AGING_DIGEST_HOUR=9
