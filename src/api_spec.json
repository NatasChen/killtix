{
  "openapi": "3.1.0",
  "info": {
    "title": "TicketDesk External Ticketing API",
    "version": "1.0.0",
    "description": "REST API for external systems (e.g. SOC) to create and manage tickets. Authentication via Bearer API token. Supports idempotent ticket creation via Idempotency-Key header or external_id.",
    "contact": {
      "name": "TicketDesk Platform Team",
      "email": "platform@ticket.example.com"
    }
  },
  "servers": [
    {
      "url": "https://ticket.example.com/api/v1",
      "description": "Production"
    },
    {
      "url": "https://staging.ticket.example.com/api/v1",
      "description": "Staging"
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    { "name": "Tickets", "description": "Ticket lifecycle operations" },
    { "name": "Threads", "description": "Ticket conversation threads" },
    { "name": "Reports", "description": "Reporting and export" },
    { "name": "Reference", "description": "Reference data (help topics, tags)" }
  ],
  "paths": {
    "/tickets": {
      "post": {
        "tags": ["Tickets"],
        "summary": "Create a ticket",
        "description": "Creates a new ticket. Idempotent when Idempotency-Key header or external_id is supplied; a repeated request returns the original ticket with HTTP 200 instead of creating a duplicate.",
        "operationId": "createTicket",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "schema": { "type": "string", "maxLength": 128 },
            "description": "Client-generated idempotency key. Replays return the original ticket."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TicketCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ticket created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Ticket" }
              }
            }
          },
          "200": {
            "description": "Idempotent replay — original ticket returned",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Ticket" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/PasswordChangeRequired" },
          "429": { "$ref": "#/components/responses/RateLimited" },
          "500": { "$ref": "#/components/responses/InternalError" }
        }
      },
      "get": {
        "tags": ["Tickets"],
        "summary": "List tickets",
        "description": "Returns a paginated, filtered list of tickets visible to the API token's scope.",
        "operationId": "listTickets",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "minimum": 1, "default": 1 } },
          { "name": "per_page", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 100, "default": 25 } },
          { "name": "status", "in": "query", "schema": { "type": "string", "enum": ["new", "open", "pending_user", "resolved", "closed"] } },
          { "name": "priority", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 5 } },
          { "name": "help_topic", "in": "query", "schema": { "type": "string" } },
          { "name": "tags", "in": "query", "schema": { "type": "string" }, "description": "Comma-separated tag names" },
          { "name": "tags_mode", "in": "query", "schema": { "type": "string", "enum": ["any", "all"], "default": "any" } },
          { "name": "aging_gt_days", "in": "query", "schema": { "type": "integer", "minimum": 1 }, "description": "Filter tickets older than N days (unresolved). e.g. 3 for 'aging > 3 days'." },
          { "name": "aging_basis", "in": "query", "schema": { "type": "string", "enum": ["created_at", "last_updated_at"], "default": "created_at" } },
          { "name": "created_from", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "created_to", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "default": "-created_at" } }
        ],
        "responses": {
          "200": {
            "description": "Ticket list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/Ticket" } },
                    "meta": { "$ref": "#/components/schemas/PaginationMeta" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/PasswordChangeRequired" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/tickets/{id}": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" }, "description": "Ticket id or number" }
      ],
      "get": {
        "tags": ["Tickets"],
        "summary": "Get a single ticket",
        "description": "Returns a ticket with its thread entries. Unauthorized access returns 404 to prevent IDOR enumeration.",
        "operationId": "getTicket",
        "responses": {
          "200": {
            "description": "Ticket detail",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TicketDetail" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/PasswordChangeRequired" }
        }
      },
      "patch": {
        "tags": ["Tickets"],
        "summary": "Update a ticket",
        "description": "Update status, assignee, priority or tags. Illegal status transitions return 409 Conflict.",
        "operationId": "updateTicket",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TicketUpdateRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ticket updated",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Ticket" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "422": { "$ref": "#/components/responses/PasswordChangeRequired" }
        }
      }
    },
    "/tickets/{id}/threads": {
      "parameters": [
        { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }
      ],
      "post": {
        "tags": ["Threads"],
        "summary": "Add a thread entry",
        "description": "Add a customer-visible reply or an internal note to a ticket.",
        "operationId": "createThread",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ThreadCreateRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Thread entry created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Thread" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "422": { "$ref": "#/components/responses/PasswordChangeRequired" }
        }
      }
    },
    "/reports/tickets": {
      "get": {
        "tags": ["Reports"],
        "summary": "Query ticket report",
        "description": "Query and export ticket reports. Supports custom-field filters and the 'aging > 3 days' backlog filter.",
        "operationId": "getTicketReport",
        "parameters": [
          { "name": "format", "in": "query", "schema": { "type": "string", "enum": ["json", "csv", "xlsx", "pdf"], "default": "json" } },
          { "name": "aging_gt_days", "in": "query", "schema": { "type": "integer", "minimum": 1 } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "priority", "in": "query", "schema": { "type": "integer", "minimum": 1, "maximum": 5 } },
          { "name": "help_topic", "in": "query", "schema": { "type": "string" } },
          { "name": "tags", "in": "query", "schema": { "type": "string" } },
          { "name": "created_from", "in": "query", "schema": { "type": "string", "format": "date-time" } },
          { "name": "created_to", "in": "query", "schema": { "type": "string", "format": "date-time" } }
        ],
        "responses": {
          "200": {
            "description": "Report result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "total": { "type": "integer" },
                    "rows": { "type": "array", "items": { "$ref": "#/components/schemas/Ticket" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "422": { "$ref": "#/components/responses/PasswordChangeRequired" }
        }
      }
    },
    "/help-topics": {
      "get": {
        "tags": ["Reference"],
        "summary": "List help topics",
        "description": "Returns active, public help topics available for ticket creation.",
        "operationId": "listHelpTopics",
        "responses": {
          "200": {
            "description": "Help topic list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/HelpTopic" }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API Token",
        "description": "API token with scopes (e.g. ticket:create, ticket:read:own)."
      }
    },
    "schemas": {
      "TicketCreateRequest": {
        "type": "object",
        "required": ["subject", "help_topic"],
        "properties": {
          "subject": { "type": "string", "maxLength": 512, "example": "[SOC] 偵測到端點 EDR-0421 疑似勒索軟體行為" },
          "description": { "type": "string", "example": "EDR 於 09:12 偵測到大量檔案加密行為，已隔離主機。" },
          "help_topic": { "type": "string", "example": "security-incident" },
          "priority": {
            "oneOf": [
              { "type": "integer", "minimum": 1, "maximum": 5 },
              { "type": "string", "enum": ["lowest", "low", "normal", "high", "critical"] }
            ],
            "example": 5
          },
          "requester": {
            "type": "object",
            "properties": {
              "email": { "type": "string", "format": "email", "example": "soc@example.com" },
              "name": { "type": "string", "example": "SOC Bot" }
            },
            "required": ["email"]
          },
          "tags": { "type": "array", "items": { "type": "string" }, "example": ["ransomware", "edr", "p1"] },
          "custom_fields": {
            "type": "object",
            "additionalProperties": true,
            "example": { "affected_host": "EDR-0421", "detection_source": "CrowdStrike" }
          },
          "external_id": { "type": "string", "maxLength": 255, "example": "SOC-2026-0001" }
        }
      },
      "TicketUpdateRequest": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["new", "open", "pending_user", "resolved", "closed"] },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "assignee_id": { "type": "integer", "nullable": true },
          "team_id": { "type": "integer", "nullable": true },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      },
      "ThreadCreateRequest": {
        "type": "object",
        "required": ["body", "type"],
        "properties": {
          "type": { "type": "string", "enum": ["agent_reply", "internal_note", "customer_message"] },
          "body": { "type": "string" },
          "visibility": { "type": "string", "enum": ["public", "internal"], "default": "public" },
          "source_channel": { "type": "string", "enum": ["web", "email", "api"], "default": "api" }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "example": "tkt_01HZX8K3" },
          "number": { "type": "string", "example": "TCK-2026-000123" },
          "subject": { "type": "string" },
          "status": { "type": "string", "enum": ["new", "open", "pending_user", "resolved", "closed"] },
          "priority": { "type": "integer", "minimum": 1, "maximum": 5 },
          "help_topic": { "type": "string" },
          "assignee_id": { "type": "integer", "nullable": true },
          "team_id": { "type": "integer", "nullable": true },
          "tags": { "type": "array", "items": { "type": "string" } },
          "sla": { "$ref": "#/components/schemas/SlaInfo" },
          "external_id": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "TicketDetail": {
        "allOf": [
          { "$ref": "#/components/schemas/Ticket" },
          {
            "type": "object",
            "properties": {
              "description": { "type": "string" },
              "custom_fields": { "type": "object", "additionalProperties": true },
              "threads": { "type": "array", "items": { "$ref": "#/components/schemas/Thread" } }
            }
          }
        ]
      },
      "Thread": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "ticket_id": { "type": "string" },
          "author_id": { "type": "integer", "nullable": true },
          "type": { "type": "string", "enum": ["customer_message", "agent_reply", "internal_note", "system_event"] },
          "visibility": { "type": "string", "enum": ["public", "internal"] },
          "body": { "type": "string" },
          "source_channel": { "type": "string" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "SlaInfo": {
        "type": "object",
        "properties": {
          "first_response_due_at": { "type": "string", "format": "date-time", "nullable": true },
          "resolution_due_at": { "type": "string", "format": "date-time", "nullable": true },
          "sla_status": { "type": "string", "enum": ["on_track", "at_risk", "overdue", "met", "breached"] }
        }
      },
      "HelpTopic": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "slug": { "type": "string", "example": "security-incident" },
          "name": { "type": "string", "example": "資安事件通報" },
          "is_public": { "type": "boolean" }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "page": { "type": "integer" },
          "per_page": { "type": "integer" },
          "total": { "type": "integer" },
          "total_pages": { "type": "integer" }
        }
      },
      "Problem": {
        "type": "object",
        "description": "RFC 7807 application/problem+json",
        "properties": {
          "type": { "type": "string", "example": "https://ticket.example.com/problems/validation_error" },
          "title": { "type": "string", "example": "Validation Error" },
          "status": { "type": "integer", "example": 400 },
          "detail": { "type": "string" },
          "instance": { "type": "string" },
          "code": { "type": "string", "example": "validation_error" },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "field": { "type": "string" },
                "message": { "type": "string" }
              }
            }
          },
          "trace_id": { "type": "string" }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Validation error",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Unauthorized": {
        "description": "Missing or invalid token",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "NotFound": {
        "description": "Resource not found or not accessible (IDOR-safe)",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "Conflict": {
        "description": "Illegal state transition or duplicate resource",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "PasswordChangeRequired": {
        "description": "must_change_password=true — only password change endpoint allowed",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "RateLimited": {
        "description": "Rate limit exceeded",
        "headers": {
          "Retry-After": { "schema": { "type": "integer" }, "description": "Seconds to wait before retrying" }
        },
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      },
      "InternalError": {
        "description": "Internal server error",
        "content": { "application/problem+json": { "schema": { "$ref": "#/components/schemas/Problem" } } }
      }
    }
  }
}
